set dotenv-load := true

default:
    @just --list

fmt:
    cargo fmt
    taplo fmt

check:
    cargo check --all-targets --all-features
    cargo clippy --all-targets --all-features -- -D warnings
    cargo deny check
    typos

test:
    cargo nextest run

coverage:
    cargo llvm-cov nextest

ci: check test

watch:
    bacon

services:
    hey project up

services-down:
    hey project down
