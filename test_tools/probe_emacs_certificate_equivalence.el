;;; probe_emacs_certificate_equivalence.el --- Opt-in path equivalence -*- lexical-binding: t; -*-
;; Emacs --batch --quick --no-site-file --load THIS ORIGINAL-GNUTLS
;;   CORRECTED-GNUTLS SYNTHETIC-FIXTURE
;; CORRECTED-GNUTLS may be "installed" to load the interpreter's normal
;; compiled gnutls library explicitly, after freezing the original function.
;; Arguments are absolute local paths. Prepare the fixture with readable/
;; containing fixture.crt, unreadable.crt (mode 000), literal[one].crt, literal?.crt, literal*.crt,
;; literal\x.crt, spaces crt.pem and brace{one}.crt; a root file named ~;
;; readable-link -> readable; broken-link -> absent; denied/existing.crt.
;; Wrap Darwin execution in allow-default sandbox-exec denying file-read-data
;; for FIXTURE/denied only. It compares 38 local cases and two inert handler
;; prefixes with identical operation traces, then checks both denied cases.
;; Remote-prefix behavior uses a synthetic handler; all process/network
;; launches are forbidden. No CA contents or TLS handshake are evaluated.
;; This is an opt-in source review artifact, never a default CI gate.
(setq native-comp-jit-compilation nil native-comp-enable-subr-trampolines nil)
(require 'cl-lib)
(require 'ert)
(defvar nixi-original-source (pop command-line-args-left))
(defvar nixi-corrected-source (pop command-line-args-left))
(defvar nixi-equivalence-root (pop command-line-args-left))
(dolist (path (list nixi-original-source nixi-equivalence-root))
  (unless (and (file-name-absolute-p path) (not (file-remote-p path)))
    (error "Absolute local source and fixture paths are required")))
(unless (or (equal nixi-corrected-source "installed")
            (and (file-name-absolute-p nixi-corrected-source)
                 (not (file-remote-p nixi-corrected-source))))
  (error "Corrected source must be local absolute path or installed mode"))
(defun nixi-equivalence-forbid-launch (&rest _)
  (error "Process/network operations forbidden in filename equivalence controls"))
(dolist (fn '(make-process make-network-process call-process call-process-region
              process-file start-process start-file-process open-network-stream))
  (advice-add fn :override #'nixi-equivalence-forbid-launch))
(load nixi-original-source nil t t)
(defalias 'nixi-original-selection (symbol-function 'gnutls--get-files))
(if (equal nixi-corrected-source "installed")
    (let ((library (locate-library "gnutls")))
      (unless (and library (string-match-p "\\.elc\\'" library))
        (error "Installed mode requires the interpreter's compiled gnutls library"))
      (load library nil t t))
  (load nixi-corrected-source nil t t))
(unless (not (eq (symbol-function 'nixi-original-selection)
                (symbol-function 'gnutls--get-files)))
  (error "Baseline and corrected functions must be distinct immutable values"))
(defvar nixi-handler-operations nil)
(defun nixi-equivalence-handler (operation &rest args)
  (push operation nixi-handler-operations)
  (pcase operation
    ('file-accessible-directory-p t)
    ('file-local-name (car args))
    ('file-remote-p nil)
    ((or 'file-name-nondirectory 'file-name-directory 'file-name-as-directory
         'directory-file-name 'expand-file-name)
     (let ((file-name-handler-alist nil)) (apply operation args)))
    ('directory-files (list (concat (car args) "fixture.crt")))
    ('file-exists-p t)
    (_ (error "Unexpected synthetic handler operation %S" operation))))
(defun nixi-selection-outcome (fn value)
  (condition-case e (funcall fn (list value)) (error e)))
(ert-deftest nixi-filename-selection-equivalence-matrix ()
  (let* ((default-directory (file-name-as-directory nixi-equivalence-root))
         (prefix (directory-file-name nixi-equivalence-root))
         (cases `((empty . "") (dot . ".") (dotdot . "..")
                  (literal-tilde . "~") (tilde-path . "~/missing.crt")
                  (relative-file . "readable/fixture.crt")
                  (relative-dir . "readable") (relative-dir-slash . "readable/")
                  (relative-dot . "readable/.") (relative-dotdot . "readable/..")
                  (relative-missing . "absent.crt")
                  (root . "/")
                  (absolute-file . ,(concat prefix "/readable/fixture.crt"))
                  (absolute-unreadable-file . ,(concat prefix "/readable/unreadable.crt"))
                  (absolute-dir . ,(concat prefix "/readable"))
                  (absolute-dir-slash . ,(concat prefix "/readable/"))
                  (absolute-dot . ,(concat prefix "/readable/."))
                  (absolute-dotdot . ,(concat prefix "/readable/.."))
                  (absolute-interior-dot . ,(concat prefix "/readable/./fixture.crt"))
                  (absolute-interior-dotdot . ,(concat prefix "/readable/../readable/fixture.crt"))
                  (absolute-missing-interior-dotdot . ,(concat prefix "/absent/../readable/fixture.crt"))
                  (double-leading-slash . ,(concat "/" prefix "/readable/fixture.crt"))
                  (double-interior-slash . ,(concat prefix "//readable/fixture.crt"))
                  (absolute-missing-file . ,(concat prefix "/absent.crt"))
                  (absolute-missing-parent . ,(concat prefix "/absent/fixture.crt"))
                  (absolute-file-as-parent . ,(concat prefix "/readable/fixture.crt/absent.crt"))
                  (symlink-parent . ,(concat prefix "/readable-link/fixture.crt"))
                  (broken-link-parent . ,(concat prefix "/broken-link/fixture.crt"))
                  (glob-star . ,(concat prefix "/readable/*.crt"))
                  (quoted-star . ,(concat prefix "/readable/literal[*].crt"))
                  (quoted-question . ,(concat prefix "/readable/literal[?].crt"))
                  (quoted-bracket . ,(concat prefix "/readable/literal[[]one].crt"))
                  (glob-question . ,(concat prefix "/readable/literal?.crt"))
                  (glob-bracket . ,(concat prefix "/readable/literal[one].crt"))
                  (escaped-star . ,(concat prefix "/readable/literal\\*.crt"))
                  (literal-backslash . ,(concat prefix "/readable/literal\\x.crt"))
                  (literal-space . ,(concat prefix "/readable/spaces crt.pem"))
                  (literal-brace . ,(concat prefix "/readable/brace{one}.crt")))))
    (dolist (case cases)
      (ert-info ((format "case %S" (car case)))
        (let ((old (nixi-selection-outcome #'nixi-original-selection (cdr case)))
              (new (nixi-selection-outcome #'gnutls--get-files (cdr case))))
          (should (equal old new))
          (princ (format "EQUIVALENT %s\n" (car case)))))))
  (dolist (file '("/nixi-handler:/fixture.crt" "/ssh:fixture.invalid:/fixture.crt"))
    (let ((file-name-handler-alist
           (cons '("\\`/\\(?:nixi-handler:\\|ssh:fixture\\.invalid:\\)/" . nixi-equivalence-handler)
                 file-name-handler-alist)) old new old-ops new-ops)
      (setq nixi-handler-operations nil)
      (setq old (nixi-selection-outcome #'nixi-original-selection file)
            old-ops (reverse nixi-handler-operations)
            nixi-handler-operations nil)
      (setq new (nixi-selection-outcome #'gnutls--get-files file)
            new-ops (reverse nixi-handler-operations))
      (should (equal old (list file)))
      (should (equal old new))
      (should (equal old-ops new-ops))
      (princ (format "EQUIVALENT handler %s operations=%S\n" file old-ops)))))
(ert-deftest nixi-denied-existing-literal-does-not-bypass-content-denial ()
  (let ((file (concat nixi-equivalence-root "/denied/existing.crt")))
    (should (file-exists-p file))
    (should-error (nixi-original-selection (list file)) :type 'file-error)
    (should (equal (gnutls--get-files (list file)) (list file)))
    (should-error (with-temp-buffer (insert-file-contents-literally file))
                  :type 'file-error)))
(ert-deftest nixi-denied-missing-literal-is-the-intended-correction ()
  (let ((file (concat nixi-equivalence-root "/denied/missing.crt")))
    (should-not (file-exists-p file))
    (should-error (nixi-original-selection (list file)) :type 'file-error)
    (should-not (gnutls--get-files (list file)))))
(ert-run-tests-batch-and-exit)
