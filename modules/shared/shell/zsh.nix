# Neutral Zsh wiring. Plugins, prompt, history policy and aliases are presets.
{
  hey,
  lib,
  config,
  pkgs,
  ...
}: let
  inherit (lib) escapeShellArg mkIf;
  inherit (lib.types) either lines listOf path str;
  inherit (hey.lib) mkBoolOpt mkOpt mkOpt';
  cfg = config.modules.shell.zsh;
  sourceFiles = files: lib.concatMapStringsSep "\n" (file: "source ${escapeShellArg (toString file)}") files;
  legacyCompiledFiles = map (name: "${config.home.configDir}/zsh/${name}.zwc") (import ../../../lib/internal/zsh-cache-files.nix);
in {
  options.modules.shell.zsh = {
    enable = mkBoolOpt false;
    rcInit = mkOpt' lines "" "Interactive Zsh initialization for the configured user.";
    envInit = mkOpt' lines "" "Zsh environment initialization for the configured user.";
    rcFiles = mkOpt (listOf (either str path)) [];
    envFiles = mkOpt (listOf (either str path)) [];
  };
  config = mkIf cfg.enable {
    programs.zsh.enable = true;
    home-manager.users.${config.user.name}.home = {
      sessionVariables.ZDOTDIR = lib.mkDefault "${config.home.configDir}/zsh";
      # Old compiled startup files can override newly managed source files.
      activation.cleanupLegacyZshCaches = config.home-manager.users.${config.user.name}.lib.dag.entryBetween ["linkGeneration"] ["writeBoundary"] ''
        run ${pkgs.coreutils}/bin/rm -f -- ${lib.escapeShellArgs legacyCompiledFiles}
      '';
    };
    home.configFile = {
      "zsh/.zshrc".source = lib.mkDefault (pkgs.writeText "nixi-zshrc" ''
        source ${escapeShellArg "${config.home.configDir}/zsh/extra.zshrc"}
      '');
      "zsh/extra.zshrc".text = ''
        # Generated by Nixi.
        ${cfg.rcInit}
        ${sourceFiles cfg.rcFiles}
      '';
      "zsh/.zshenv".text = ''
        # Generated by Nixi.
        ${cfg.envInit}
        ${sourceFiles cfg.envFiles}
      '';
    };
  };
}
