{
  config,
  hey,
  lib,
  pkgs,
  ...
}: let
  inherit (lib) concatMapStrings mkIf;
  inherit (pkgs.tmuxPlugins) copycat prefix-highlight resurrect yank;

  cfg = config.modules.shell.tmux;
  uniqueRcFiles = hey.lib.uniqueContentPaths cfg.rcFiles;
in {
  config = mkIf (cfg.enable && config.modules.profiles.tmux-workstation.enable) {
    home.configFile."tmux/extraInit" = {
      text = ''
        # This file is auto-generated by nixos, don't edit by hand!
        ${concatMapStrings (path: "source-file '${path}'\n") uniqueRcFiles}
        run-shell '${copycat}/share/tmux-plugins/copycat/copycat.tmux'
        run-shell '${prefix-highlight}/share/tmux-plugins/prefix-highlight/prefix_highlight.tmux'
        run-shell '${yank}/share/tmux-plugins/yank/yank.tmux'
        run-shell '${resurrect}/share/tmux-plugins/resurrect/resurrect.tmux'
      '';
      executable = true;
    };
  };
}
